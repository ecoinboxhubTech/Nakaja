# Copy to .env (never commit .env). Without keys the site still works in a safe mock mode.

# AI (https://console.groq.com/keys)
GROQ_API_KEY=
# Optional: any Groq chat model, e.g. openai/gpt-oss-120b or openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b

# Email sending (https://resend.com): verify your domain, then create an API key
RESEND_API_KEY=
MAIL_FROM=NAKAJAH Care Foundation <hello@nakajahcare.org>
# No domain yet? Use Gmail instead of Resend: turn on 2-step verification, create an App Password
# (Google Account > Security > App passwords), and set these two (leave RESEND_API_KEY empty).
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=16-character-app-password
# Where staff notifications + AI drafts are delivered
STAFF_EMAIL=hello@nakajahcare.org

# draft = AI writes a suggested reply and staff approve it (recommended)
# auto  = AI replies directly to routine emails; safeguarding concerns are NEVER auto-answered
AUTO_REPLY=draft

# Shared secret for the inbound-email webhook: /api/inbound-email?secret=...
INBOUND_SECRET=

PORT=8787

# Optional: absolute path to the built frontend (defaults to ../frontend/dist)
# FRONTEND_DIST=

# Optional: absolute path to the built frontend (defaults to ../frontend/dist)
# FRONTEND_DIST=

# Signs the chat assistant's "confirm before sending" requests (16+ random chars; e.g. python -c "import secrets;print(secrets.token_urlsafe(32))").
# Without it the assistant answers questions but cannot file contact requests.
ACTION_SECRET=

# Supabase Postgres (run schema.sql once in the SQL editor). Direct connection string, backend only.
# On Vercel use the Transaction pooler string (port 6543): postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
