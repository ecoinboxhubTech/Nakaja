# Copy to .env (never commit .env). Without keys the site still works in a safe mock mode.

# AI (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: cheaper/faster model for the public chat, e.g. claude-sonnet-5-5 or claude-haiku-5-5
ANTHROPIC_MODEL=claude-opus-5-5

# Email sending (https://resend.com): verify your domain, then create an API key
RESEND_API_KEY=
MAIL_FROM=NAKAJAH Care Foundation <hello@nakajahcare.org>
# Where staff notifications + AI drafts are delivered
STAFF_EMAIL=hello@nakajahcare.org

# draft = AI writes a suggested reply and staff approve it (recommended)
# auto  = AI replies directly to routine emails; safeguarding concerns are NEVER auto-answered
AUTO_REPLY=draft

# Shared secret for the inbound-email webhook: /api/inbound-email?secret=...
INBOUND_SECRET=

PORT=8787
